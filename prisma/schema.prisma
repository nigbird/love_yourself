
datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

generator client {
  provider   = "prisma-client-js"
  engineType = "binary"
}

// ================================================= //
// ///////////////// User Models /////////////////// //
// ================================================= //

model User {
  id                  String                @id @default(cuid())
  email               String                @unique
  name                String?
  rewardPoints        Int                   @default(0)
  createdAt           DateTime              @default(now())
  updatedAt           DateTime              @updatedAt
  routines            Routine[]
  goals               Goal[]
  journalEntries      JournalEntry[]
  wishes              Wish[]
  redeemableRewards   RedeemableReward[]
  routineLogs         RoutineCompletionLog[]
  goalLogs            GoalCompletionLog[]
  wishFulfillmentLogs WishFulfillmentLog[]
  rewardRedemptionLog RewardRedemptionLog[]
}

// ================================================= //
// //////////////// Feature Models ///////////////// //
// ================================================= //

model Goal {
  id           String    @id @default(cuid())
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId       String
  name         String
  type         String // Was GoalType enum
  rewardPoints Int
  targetValue  Float?
  currentValue Float?
  unit         String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

model JournalEntry {
  id        String   @id @default(cuid())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  title     String
  content   String
  imageUrl  String?
  mood      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Wish {
  id        String   @id @default(cuid())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  title     String
  note      String?
  imageUrl  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Routine {
  id               String   @id @default(cuid())
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId           String
  name             String
  frequency        String   // Was RoutineFrequency enum
  daysOfWeek       String? // Storing as comma-separated string
  timeOfDay        String?
  remindersEnabled Boolean  @default(true)
  rewardPoints     Int
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model RedeemableReward {
  id          String   @id @default(cuid())
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId      String
  title       String
  description String?
  cost        Int
  isEnabled   Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// ================================================= //
// ////////////////// Log Models /////////////////// //
// ================================================= //

model RoutineCompletionLog {
  id           String   @id @default(cuid())
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId       String
  routineId    String
  routineName  String
  rewardPoints Int
  completedAt  DateTime @default(now())
}

model GoalCompletionLog {
  id           String   @id @default(cuid())
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId       String
  goalId       String
  goalName     String
  goalType     String
  rewardPoints Int
  completedAt  DateTime @default(now())
}

model WishFulfillmentLog {
  id          String   @id @default(cuid())
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId      String
  wishId      String
  wishTitle   String
  wishNote    String?
  imageUrl    String?
  fulfilledAt DateTime @default(now())
}

model RewardRedemptionLog {
  id          String   @id @default(cuid())
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId      String
  rewardId    String
  rewardTitle String
  pointsSpent Int
  redeemedAt  DateTime @default(now())
}
