// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id               String    @id @unique
  email            String?   @unique
  name             String?
  rewardPoints     Int       @default(0)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  routines         Routine[]
  goals            Goal[]
  journalEntries   JournalEntry[]
  wishes           Wish[]
  notifications    Notification[]
  redeemableRewards RedeemableReward[]
  rewardRedemptionLogs RewardRedemptionLog[]
  routineCompletionLogs RoutineCompletionLog[]
  goalCompletionLogs GoalCompletionLog[]
  wishFulfillmentLogs WishFulfillmentLog[]
}

model Routine {
  id               String    @id @default(cuid())
  userId           String
  name             String
  frequency        String // daily, weekly, monthly, custom
  daysOfWeek       String? // Comma-separated list of numbers (0-6)
  timeOfDay        String? // HH:MM
  remindersEnabled Boolean   @default(true)
  rewardPoints     Int
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model RoutineCompletionLog {
  id           String   @id @default(cuid())
  userId       String
  routineId    String
  routineName  String
  rewardPoints Int
  completedAt  DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  @@index([userId])
}

model Goal {
  id           String   @id @default(cuid())
  userId       String
  name         String
  type         String // personal_measurable, spiritual
  rewardPoints Int
  targetValue  Float?
  currentValue Float?
  unit         String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model GoalCompletionLog {
  id           String   @id @default(cuid())
  userId       String
  goalId       String
  goalName     String
  goalType     String
  rewardPoints Int
  completedAt  DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}


model JournalEntry {
  id        String   @id @default(cuid())
  userId    String
  title     String
  content   String
  imageUrl  String?
  mood      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Wish {
  id        String   @id @default(cuid())
  userId    String
  title     String
  note      String?
  imageUrl  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model WishFulfillmentLog {
  id          String   @id @default(cuid())
  userId      String
  wishId      String
  wishTitle   String
  wishNote    String?
  imageUrl    String?
  fulfilledAt DateTime
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  message   String
  url       String?
  read      Boolean  @default(false)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  @@index([userId])
}

model RedeemableReward {
  id                 String    @id @default(cuid())
  userId             String
  title              String
  description        String?
  cost               Int
  isEnabled          Boolean   @default(true)
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  user               User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  redemptionLogs     RewardRedemptionLog[]

  @@index([userId])
}

model RewardRedemptionLog {
  id           String   @id @default(cuid())
  userId       String
  rewardId     String
  rewardTitle  String
  pointsSpent  Int
  redeemedAt   DateTime @default(now())
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
