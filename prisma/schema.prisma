
// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id    String @id @unique
  email String? @unique
  name  String?
  rewardPoints Int @default(0)

  routines           Routine[]
  goals              Goal[]
  journalEntries     JournalEntry[]
  wishes             Wish[]
  redeemableRewards  RedeemableReward[]
  
  routineCompletionLogs RoutineCompletionLog[]
  goalCompletionLogs    GoalCompletionLog[]
  wishFulfillmentLogs   WishFulfillmentLog[]
  rewardRedemptionLogs  RewardRedemptionLog[]
  notifications         Notification[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Routine {
  id        String  @id @default(cuid())
  userId    String
  name      String
  frequency String // 'daily', 'weekly', 'monthly', 'custom'
  daysOfWeek String? // Comma-separated list of day numbers (0-6)
  timeOfDay String? // HH:MM format
  remindersEnabled Boolean @default(true)
  rewardPoints     Int

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  completionLogs RoutineCompletionLog[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  @@index([userId])
}

model Goal {
  id           String  @id @default(cuid())
  userId       String
  name         String
  type         String // 'personal_measurable' or 'spiritual'
  targetValue  Float?
  currentValue Float?
  unit         String?
  rewardPoints Int

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

model JournalEntry {
  id       String  @id @default(cuid())
  userId   String
  title    String
  content  String
  imageUrl String?
  mood     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

model Wish {
  id       String  @id @default(cuid())
  userId   String
  title    String
  note     String?
  imageUrl String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

model RoutineCompletionLog {
  id           String   @id @default(cuid())
  userId       String
  routineId    String
  routineName  String
  rewardPoints Int
  completedAt  DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  routine Routine @relation(fields: [routineId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([routineId])
}

model GoalCompletionLog {
  id           String   @id @default(cuid())
  userId       String
  goalId       String?   // Made optional to allow original goal to be deleted
  goalName     String
  goalType     String
  rewardPoints Int
  completedAt  DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  // No relation to Goal model to prevent foreign key constraint violation on deletion

  @@index([userId])
}

model WishFulfillmentLog {
  id          String   @id @default(cuid())
  userId      String
  wishId      String?   // Made optional
  wishTitle   String
  wishNote    String?
  imageUrl    String?
  fulfilledAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model RedeemableReward {
  id          String   @id @default(cuid())
  userId      String
  title       String
  description String?
  cost        Int

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  redemptionLogs RewardRedemptionLog[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  @@index([userId])
}

model RewardRedemptionLog {
  id           String   @id @default(cuid())
  userId       String
  rewardId     String?   // Made optional
  rewardTitle  String
  pointsSpent  Int
  redeemedAt   DateTime @default(now())

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  reward RedeemableReward? @relation(fields: [rewardId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([rewardId])
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  message   String
  url       String?
  read      Boolean  @default(false)
  
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  
  @@index([userId])
}
