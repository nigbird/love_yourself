
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id                  String                @id @unique
  email               String?               @unique
  name                String?
  rewardPoints        Int                   @default(0)
  routines            Routine[]
  goals               Goal[]
  journalEntries      JournalEntry[]
  notifications       Notification[]
  wishes              Wish[]
  redeemableRewards   RedeemableReward[]
  goalCompletionLogs  GoalCompletionLog[]
  rewardRedemptionLogs RewardRedemptionLog[]
  wishFulfillmentLogs WishFulfillmentLog[]
  routineCompletionLogs RoutineCompletionLog[]
  createdAt           DateTime              @default(now())
  updatedAt           DateTime              @updatedAt
}

model Routine {
  id                String                 @id @default(cuid())
  userId            String
  name              String
  frequency         String // 'daily', 'weekly', 'monthly', 'custom'
  daysOfWeek        String? // Comma-separated numbers (0-6)
  timeOfDay         String? // HH:MM format
  remindersEnabled  Boolean                @default(true)
  rewardPoints      Int
  user              User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  completionLogs    RoutineCompletionLog[]
  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @updatedAt

  @@index([userId])
}

model RoutineCompletionLog {
  id           String   @id @default(cuid())
  routineId    String
  userId       String
  routineName  String
  rewardPoints Int
  completedAt  DateTime @default(now())
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  routine      Routine  @relation(fields: [routineId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([routineId])
}


model Goal {
  id           String   @id @default(cuid())
  userId       String
  name         String
  type         String // 'personal_measurable' or 'spiritual'
  targetValue  Int?
  currentValue Int?
  unit         String?
  rewardPoints Int
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([userId])
}

model GoalCompletionLog {
  id           String   @id @default(cuid())
  goalId       String   // No relation here, as the original goal is deleted
  userId       String
  goalName     String
  goalType     String
  rewardPoints Int
  completedAt  DateTime @default(now())
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}


model JournalEntry {
  id        String   @id @default(cuid())
  userId    String
  title     String
  content   String
  imageUrl  String?
  mood      String?
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  message   String
  read      Boolean  @default(false)
  url       String?
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@index([userId])
}

model Wish {
  id        String   @id @default(cuid())
  userId    String
  title     String
  note      String?
  imageUrl  String?
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

model WishFulfillmentLog {
  id          String   @id @default(cuid())
  wishId      String   // No relation here, as the original wish is deleted
  userId      String
  wishTitle   String
  wishNote    String?
  imageUrl    String?
  fulfilledAt DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model RedeemableReward {
  id          String                @id @default(cuid())
  userId      String
  title       String
  description String?
  cost        Int
  isEnabled   Boolean               @default(true)
  user        User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  redemptionLogs RewardRedemptionLog[]
  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt

  @@index([userId])
}

model RewardRedemptionLog {
  id          String   @id @default(cuid())
  userId      String
  rewardId    String   // No relation here, as we may want to keep logs even if reward is deleted
  rewardTitle String
  pointsSpent Int
  redeemedAt  DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}
